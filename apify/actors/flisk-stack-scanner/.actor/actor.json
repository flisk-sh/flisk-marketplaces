{
  "actorSpecification": 1,
  "name": "flisk-stack-scanner",
  "title": "App Stack Map: List Every Part of Your App (Flisk)",
  "description": "Paste a GitHub repo and see every part of your app: API, website, workers, AI agents and database, with ports and what depends on what. Flags broken service.json files before your app won't start.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Flisk services",
      "views": {
        "services": {
          "title": "Services",
          "transformation": { "fields": ["appName", "appType", "stack", "port", "dependsOn", "issues", "path"] },
          "display": {
            "component": "table",
            "properties": {
              "appName": { "label": "Name" },
              "appType": { "label": "Type" },
              "stack": { "label": "Stack" },
              "port": { "label": "Port" },
              "dependsOn": { "label": "Depends on" },
              "issues": { "label": "Issues" },
              "path": { "label": "Manifest path" }
            }
          }
        }
      }
    }
  }
}
