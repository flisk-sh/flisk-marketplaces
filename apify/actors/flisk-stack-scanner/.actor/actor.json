{
  "actorSpecification": 1,
  "name": "flisk-stack-scanner",
  "title": "What Is My App Made Of? Check Any GitHub App (Flisk)",
  "description": "Paste a GitHub link and see every piece of your app in one table: the website, the parts behind it, and which piece needs which. Finds broken settings files before your app fails to start.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Pieces of your app",
      "views": {
        "services": {
          "title": "Services",
          "transformation": { "fields": ["appName", "appType", "stack", "port", "dependsOn", "issues", "path"] },
          "display": {
            "component": "table",
            "properties": {
              "appName": { "label": "Piece" },
              "appType": { "label": "Kind" },
              "stack": { "label": "Group" },
              "port": { "label": "Port" },
              "dependsOn": { "label": "Needs" },
              "issues": { "label": "Problems found" },
              "path": { "label": "File" }
            }
          }
        }
      }
    }
  }
}
