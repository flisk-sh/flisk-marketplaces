{
  "actorSpecification": 1,
  "name": "flisk-app-starter",
  "title": "Build an App: Online Shop, SaaS, AI Agent Starters (Flisk)",
  "description": "Pick what you want to build and get a ready-to-run app project: online shop, SaaS with checkout, restaurant app, AI agent app or login system. Runs on your computer with one command.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Your app starter",
      "views": {
        "starter": {
          "title": "Your app",
          "transformation": { "fields": ["title", "youGet", "download", "run", "needs"] },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "What you are building" },
              "youGet": { "label": "What you get" },
              "download": { "label": "Download (ZIP)", "format": "link" },
              "run": { "label": "Start it with" },
              "needs": { "label": "Needs" }
            }
          }
        }
      }
    }
  }
}
