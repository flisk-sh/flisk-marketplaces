{
  "actorSpecification": 1,
  "name": "flisk-app-starter",
  "title": "Build an App Fast: Shop, Website, Booking, AI Helper (Flisk)",
  "description": "Say what you want to build. Get a working app back: an online shop, a website with login, a restaurant booking app or an AI helper. Starts on your computer with one command.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Your new app",
      "views": {
        "starter": {
          "title": "Your app",
          "transformation": { "fields": ["title", "youGet", "download", "run", "needs"] },
          "display": {
            "component": "table",
            "properties": {
              "title": { "label": "What you are building" },
              "youGet": { "label": "What you get" },
              "download": { "label": "Download (ZIP)", "format": "link" },
              "run": { "label": "Start it with" },
              "needs": { "label": "Needs" }
            }
          }
        }
      }
    }
  }
}
